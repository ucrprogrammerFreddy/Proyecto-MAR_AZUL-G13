@model IEnumerable<AppUsuarios.Models.Articulos>

@{
	ViewData["Title"] = "Home Page";
	var articles = Model ?? new List<AppUsuarios.Models.Articulos>();
}

<!-- Mostrar mensajes de error si hay problemas con la API -->
@if (TempData["Mensaje"] != null)
{
	<div class="alert alert-danger">@TempData["Mensaje"]</div>
}

<!-- Enlazar el archivo CSS -->
<link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/PaginaPrincipal.css" asp-append-version="true" />

<div class="container mt-4">
	<div class="header">

		<h1 class="fw-bold m-0 text-primary">MAR <span class="text-info">AZUL</span><img src="~/img/logo.png" alt="Logo" class="ms-2" style="height: 40px;"></h1>


	</div>

	<p>Total de artículos recibidos: @articles.Count()</p>

	<!-- Carrousel -->
	<!-- Carrousel -->
	<div class="col-md-12">
		<div id="carouselExampleFade" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="3000">
			<div class="carousel-inner">
				@if (!articles.Any())
				{
					<p>No hay artículos disponibles.</p>
				}
				else
				{
					bool isActive = true;
					@foreach (var articulo in articles)
					{
						<div class="carousel-item @(isActive ? "active" : "")">
							<img src="@(string.IsNullOrEmpty(articulo.UrlImagen) ? "/img/default.png" : articulo.UrlImagen)"
								 alt="@Html.DisplayFor(modelItem => articulo.Nombre)" class="d-block w-100"
								 onerror="this.onerror=null; this.src='/img/default.png';" />
						</div>
						isActive = false;
						  <!-- Desactiva la clase active para los siguientes elementos -->
					}
				}
			</div>
			<button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleFade" data-bs-slide="prev">
				<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Anterior</span>
			</button>
			<button class="carousel-control-next" type="button" data-bs-target="#carouselExampleFade" data-bs-slide="next">
				<span class="carousel-control-next-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Siguiente</span>
			</button>
		</div>
	</div>


	<br />
	<hr />

	<h2>Articulos recientes</h2>
	<!-- Contenedor de los artículos -->
	<div class="articulos-lista">
		@if (!articles.Any())
		{
			<p>No hay artículos disponibles.</p>
		}
		else
		{
			@foreach (var articulo in articles)
			{
				<div class="articulo" style="border: 1px solid #ddd; margin-bottom: 10px; padding: 10px;">
					<div class="row">
					</div>
					<div class="row">
						<div class="col-3">
							<img src="@(string.IsNullOrEmpty(articulo.UrlImagen) ? "/img/default.png" : articulo.UrlImagen)"
								 alt="@Html.DisplayFor(modelItem => articulo.Nombre)"
								 style="max-width: 200px; height: auto;"
								 onerror="this.onerror=null; this.src='/img/default.png';" />
						</div>
						<div class="col">
							<h2>@Html.DisplayFor(modelItem => articulo.Nombre)</h2>
							<p>@Html.DisplayFor(modelItem => articulo.Descripcion)</p>
						</div>
					</div>



				</div>
			}
		}
	</div>
	<hr />
	<div class="row">
		<h2>Contacta con nuestro equipo</h2>
		<div class="col-6">

			<form id="contactForm">
				<div class="mb-3">
					<label for="email" class="form-label">Correo Electrónico</label>
					<input type="email" class="form-control" id="email" name="email" required>
				</div>
				<div class="mb-3">
					<label for="asunto" class="form-label">Asunto</label>
					<input type="text" class="form-control" id="asunto" name="asunto" required>
				</div>
				<div class="mb-3">
					<label for="mensaje" class="form-label">Mensaje</label>
					<textarea class="form-control" id="mensaje" name="mensaje" rows="4" required></textarea>
				</div>
				<button type="submit" class="btn btn-outline-dark mt-auto" id="BtnEnviar">Enviar Mensaje</button>
			</form>
		</div>
		<div class="col-6">
			<img src="~/img/logo.png" alt="Logo" class="ms-2" style="height: 350px;">
		</div>
	</div>

	<div id="contactResponse" class="mt-3"></div>


	<style>
		#BtnEnviar:hover {
			background-color: blue;
		}

		.carousel-control-prev-icon, .carousel-control-next-icon {
			background-color: black; /* Cambiar color de los botones */
		}

		.carousel-control-prev, .carousel-control-next {
			background-color: rgba(0, 0, 0, 0.5); /* Fondo negro semitransparente */
		}

			.carousel-control-prev:hover, .carousel-control-next:hover {
				background-color: rgba(0, 0, 0, 0.8); /* Fondo más oscuro al pasar el mouse */
			}
	</style>

	@section Scripts
 {
		<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
		<script>
			$(document).ready(function () {
				$("#contactForm").submit(function (event) {
					event.preventDefault();

					$.ajax({
						type: "POST",
						url: "/Email/EnviarCorreo",
						data: $(this).serialize(),
						success: function (response) {
							if (response.success) {
								$("#contactResponse").html('<div class="alert alert-success">' + response.message + '</div>');
								$("#contactForm")[0].reset();
							} else {
								$("#contactResponse").html('<div class="alert alert-danger">' + response.message + '</div>');
							}
						},
						error: function () {
							$("#contactResponse").html('<div class="alert alert-danger">Hubo un error al enviar el mensaje.</div>');
						}
					});
				});
			});
		</script>
	}
