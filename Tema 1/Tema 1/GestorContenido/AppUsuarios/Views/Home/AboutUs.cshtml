@{
    ViewData["Title"] = "Sobre Nosotros | Mar Azul";
}

<div class="container mt-5">
    <div class="row">
        <!-- Imagen a la izquierda y contenido a la derecha -->
        <div class="col-md-4">
            <img src="~/img/logo.png"
                 class="img-fluid rounded shadow"
                 alt="Editorial Mar Azul"
                 style="height: 300px;">
        </div>
        <div class="col-md-8">
            <h1 class="text-primary">Sobre Nosotros</h1>
            <p class="lead">Editorial <strong>Mar Azul</strong> nació con la pasión por compartir historias que inspiran, educan y transforman.</p>
            <p>Desde nuestra fundación, hemos trabajado con escritores de diversas partes del mundo, ofreciendo una plataforma para voces únicas y auténticas.</p>
        </div>
    </div>

    <hr class="my-5">

    <!-- Misión y Visión -->
    <div class="row text-center">
        <div class="col-md-6">
            <h3 class="text-secondary">Nuestra Misión</h3>
            <p>Publicar contenido de calidad que fomente el pensamiento crítico, la imaginación y el aprendizaje continuo.</p>
        </div>
        <div class="col-md-6">
            <h3 class="text-secondary">Nuestra Visión</h3>
            <p>Ser una editorial de referencia a nivel internacional, impulsando nuevas voces literarias y académicas.</p>
        </div>
    </div>

    <hr class="my-5">

    <!-- Equipo -->
    <h2 class="text-center text-primary mb-4">Nuestro Equipo</h2>
    <div class="row text-center">
        <div class="col-md-4">
            <img src="https://dummyimage.com/150x150/007bff/ffffff&text=JD"
                 class="rounded-circle mb-2"
                 alt="Director">
            <h5>Juan Díaz</h5>
            <p>Fundador & Director</p>
        </div>
        <div class="col-md-4">
            <img src="https://dummyimage.com/150x150/007bff/ffffff&text=MR"
                 class="rounded-circle mb-2"
                 alt="Editora">
            <h5>María Rodríguez</h5>
            <p>Jefa de Edición</p>
        </div>
        <div class="col-md-4">
            <img src="https://dummyimage.com/150x150/007bff/ffffff&text=AL"
                 class="rounded-circle mb-2"
                 alt="Marketing">
            <h5>Alejandro López</h5>
            <p>Marketing & Comunicación</p>
        </div>
    </div>

    <hr class="my-5">

    <!-- Contacto -->
    <div class="text-center">
        <h3>¿Quieres saber más?</h3>
        <p>Contáctanos en <strong>contacto@marazul.com</strong></p>
        <a href="/Contacto" class="btn btn-primary">Contáctanos</a>
    </div>
</div>
