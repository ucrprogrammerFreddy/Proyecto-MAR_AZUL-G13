@model AppUsuarios.Models.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6" style="background-color: #607B9E; padding: 20px; border-radius: 5px;">
            <div style="text-align: center;">
                <i class="bi bi-image" style="font-size: 4em; color: white;"></i>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-4 mt-3 shadow-lg">
                <h4 class="text-center"><strong>Solicitud de creación de cuenta</strong></h4>
                <hr />
                <form asp-controller="Usuarios" asp-action="Create" method="post" autocomplete="off">

                    <div class="mb-3">
                        <label class="form-label"><strong>Correo:</strong></label>
                        <input asp-for="Email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Nombre completo:</strong></label>
                        <input asp-for="Nombre" class="form-control" required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Rol solicitado:</strong></label>
                        <select asp-for="Rol" class="form-control" required>
                            <option value="">Seleccione</option>
                            <option value="Administrador">Administrador</option>
                            <option value="Escritor">Escritor</option>
                            <option value="Autorizador">Autorizador</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Clave:</strong></label>
                        <input asp-for="Clave" type="password" class="form-control" required />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>

                    <!-- Se establece un estado predeterminado -->
                    <!-- CAMPO OCULTO PARA QUE EL ESTADO SIEMPRE SEA INACTIVO -->
                    <input type="hidden" asp-for="Estado" value="Inactivo" />


                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Volver</a>
                        <button type="submit" class="btn btn-primary">Enviar</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
