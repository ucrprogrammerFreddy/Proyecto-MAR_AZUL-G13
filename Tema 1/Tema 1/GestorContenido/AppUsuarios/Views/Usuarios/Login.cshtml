@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-body">
                    <h3 class="text-center text-primary">Iniciar Sesión</h3>
                    <hr />

                    <form id="loginForm" method="post" action="/Usuarios/Login">
                        <input type="hidden" id="returnUrl" name="returnUrl" value="@(Context.Request.Query["ReturnUrl"].ToString())" />
                        <div class="mb-3">
                            <label class="form-label"><strong>Correo:</strong></label>
                            <input type="email" id="email" name="email" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><strong>Clave:</strong></label>
                            <input type="password" id="clave" name="clave" class="form-control" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                        </div>
                        <div class="text-center mt-3">
                            <p>¿No tienes una cuenta? <a asp-controller="Usuarios" asp-action="Create" class="btn btn-link">Solicitar una</a></p>
                        </div>

                        <div class="mt-3 text-center">
                            <p class="text-danger" id="error-message"></p>
                        </div>
                        <div class="text-danger text-center">
                            @if (ViewData["Error"] != null)
                            {
                                <p>@ViewData["Error"]</p>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("loginForm").addEventListener("submit", async function (event) {
            event.preventDefault();

            const emailField = document.getElementById("email");
            const claveField = document.getElementById("clave");
            const errorMessage = document.getElementById("error-message");
            const returnUrlField = document.getElementById("returnUrl");

            if (!emailField || !claveField || !errorMessage || !returnUrlField) {
                console.error("❌ ERROR: No se encontraron los campos del formulario.");
                return;
            }

            const email = emailField.value.trim();
            const clave = claveField.value.trim();
            const returnUrl = returnUrlField.value.trim();

            if (email === "" || clave === "") {
                errorMessage.textContent = "⚠️ Email y contraseña son obligatorios.";
                emailField.focus();
                return;
            }

            try {
                console.log(`📤 Intentando login con Email: ${email}`);

                const response = await fetch("/Usuarios/Login", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: new URLSearchParams({ email, clave, returnUrl })
                });

                if (!response.ok) {
                    console.error("❌ Usuario o clave incorrectos.");
                    errorMessage.textContent = "⚠️ Usuario o clave incorrectos.";
                    return;
                }

                console.log("✅ Login exitoso. Redirigiendo...");
                window.location.replace(returnUrl && returnUrl !== "null" ? returnUrl : "/Home/Index");
            } catch (error) {
                console.error("❌ Error en la petición:", error);
                errorMessage.textContent = "❌ Error de conexión con el servidor.";
            }
        });
    });
</script>
