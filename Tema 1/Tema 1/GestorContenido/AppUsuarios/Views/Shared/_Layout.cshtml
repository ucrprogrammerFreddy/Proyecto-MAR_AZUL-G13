

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Mar Azul</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/CapaPresentaciónAdmin.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.datatables.net/2.2.1/css/dataTables.dataTables.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-sweetalert/dist/sweetalert.css">


</head>
<body class="sb-nav-fixed">
	<nav class="sb-topnav navbar navbar-expand navbar-light ">
		<!-- Navbar Brand-->
		<div class="">
			<a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center text-decoration-none">
				<h3 class="fw-bold m-0 text-primary">MAR <span class="text-info">AZUL</span></h3>
				<img src="~/img/logo.png" alt="Logo" class="ms-2" style="height: 40px;">
			</a>



		</div>
		<!-- Sidebar Toggle-->
		<button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#!"><i class="fas fa-bars"></i></button>

		<a class="nav-link " asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
		@if (User.Identity.IsAuthenticated)
		{
			@if(User.IsInRole("Administrador")){

				<a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
			}

			<a class="nav-link" asp-controller="Secciones" asp-action="Index">Secciones</a>

			<a class="nav-link" asp-controller="Etiquetas" asp-action="Index">Etiquetas</a>
		}

		<a class="nav-link " asp-area="" asp-controller="Home" asp-action="AboutUs">Sobre nosotros</a>
		<a class="nav-link " asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
		
		<!-- Navbar Search-->
		@*<form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
			<div class="input-group">
				<input class="form-control" type="text" placeholder="Search for..." aria-label="Search for..." aria-describedby="btnNavbarSearch" />
				<button class="btn btn-primary" id="btnNavbarSearch" type="button"><i class="fas fa-search"></i></button>
			</div>
		</form>*@
		<!-- Navbar-->
		<ul class="navbar-nav  ms-auto me-0 me-md-3 my-2 my-md-0">
			<li class="nav-item dropdown">
				<a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-user fa-fw"></i></a>
				<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
					@if (User.Identity.IsAuthenticated)
					{
						<li class="nav-item">
							<a class="nav-link text-dark" asp-controller=""
							   asp-action="">Hola @User.Identity.Name</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark" asp-controller="Usuarios"
							   asp-action="Logout">
								Cerrar sesión
							</a>
						</li>
					}
					else
					{
						<li class="nav-item">
							<a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Login">
								Iniciar sesión
							</a>
						</li>
					}
				</ul>
			</li>
		</ul>
	</nav>
	<div id="layoutSidenav">
		<div id="layoutSidenav_nav">
			<nav class="sb-sidenav accordion sb-sidenav-ligth bg-white text-dark" id="sidenavAccordion">
				<div class="sb-sidenav-menu">
					<div class="nav">
						<div class="sb-sidenav-menu-heading sidewhite">Secciones</div>
						<div id="secciones-container">
							<p class="text-muted px-3">Cargando secciones...</p>
						</div>
						@if (User.Identity.IsAuthenticated)
						{
							<div class="sb-sidenav-menu-heading sidewhite">Gestión</div>
							
							<ul>
								
								<li>
									<a class="nav-link toggle-submenu" href="#" id="togglePublicaciones">
										<div class="sb-nav-link-icon"><i class="fas fa-table"></i></div>
										Publicaciones
										<i class="fas fa-chevron-down ms-auto"></i> <!-- Flecha indicadora -->
									</a>
									<ul class="submenu" id="publicacionesSubmenu">
											
											<li>
												<a class="nav-link" asp-controller="Home" asp-action="Index">
													Ver publicaciones
												</a>
											</li>
										<li>
											<a class="nav-link" asp-controller="Articulos" asp-action="Gestion">
												Gestion de publicaciones
											</a>
										</li>
										<li>
											<a class="nav-link" asp-controller="Articulos" asp-action="Create">
												Crear publicación
											</a>
										</li>
									</ul>
								</li>

								<li>
									<a class="nav-link toggle-submenu" href="#" id="toggleEtiquetas">
										<div class="sb-nav-link-icon"><i class="fas fa-tag"></i></div>
										Etiquetas
										<i class="fas fa-chevron-down ms-auto"></i> <!-- Flecha indicadora -->
									</a>
									<ul class="submenu" id="publicacionesSubmenu">
										<li>
											<a class="nav-link" asp-controller="Etiquetas" asp-action="Index">
												Ver todas las etiquetas
											</a>
										</li>
										<li>
											<a class="nav-link" asp-controller="Etiquetas" asp-action="Create">
												Crear etiqueta
											</a>
										</li>
									</ul>
								</li>
								@if(User.IsInRole("Administrador")||User.IsInRole("Autorizador")){
									<li>
										<a class="nav-link toggle-submenu" href="#" id="toggleCategorias">
											<div class="sb-nav-link-icon"><i class="fas fa-clipboard"></i></div>
											Categorias
											<i class="fas fa-chevron-down ms-auto"></i> <!-- Flecha indicadora -->
										</a>
										<ul class="submenu" id="publicacionesSubmenu">
											<li>
												<a class="nav-link" asp-controller="Categorias" asp-action="Index">
													Ver todas las categorias
												</a>
											</li>
											<li>
												<a class="nav-link" asp-controller="Categorias" asp-action="Create">
													Crear categorias
												</a>
											</li>
										</ul>
									</li>
								}
								@if (User.IsInRole("Administrador"))
								{
									<li>
										<a class="nav-link toggle-submenu" href="#" id="toggleCategorias">
											<div class="sb-nav-link-icon"><i class="fas fa-list"></i></div>
											Secciones
											<i class="fas fa-chevron-down ms-auto"></i> <!-- Flecha indicadora -->
										</a>
										<ul class="submenu" id="publicacionesSubmenu">
											<li>
												<a class="nav-link" asp-controller="Secciones" asp-action="Index">
													Ver todas las secciones
												</a>
											</li>
											<li>
												<a class="nav-link" asp-controller="Secciones" asp-action="Create">
													Crear secciones
												</a>
											</li>
										</ul>
									</li>
									<li>
										<a class="nav-link toggle-submenu" href="#" id="toggleCategorias">
											<div class="sb-nav-link-icon"><i class="fas fa-user"></i></div>
											Usuarios
											<i class="fas fa-chevron-down ms-auto"></i> <!-- Flecha indicadora -->
										</a>
										<ul class="submenu" id="publicacionesSubmenu">
											<li>
												<a class="nav-link" asp-controller="Usuarios" asp-action="Index">
													Ver todos las Usuarios
												</a>
											</li>
											<li>
												<a class="nav-link" asp-controller="Usuarios" asp-action="Create">
													Crear Usuarios
												</a>
											</li>
										</ul>
									</li>
									<li>
										<a class="nav-link" asp-controller="Home" asp-action="Estadistica">
											<div class="sb-nav-link-icon"><i class=" fa-solid fa-signal"></i></div>
											Estadistica
										</a>

									</li>
								}
								
							</ul>

						}

					</div>
				</div>
				<div class="sb-sidenav-footer ">
					<div class="small">Sesión iniciada como:</div>
					@User.Identity.Name
				</div>
			</nav>
		</div>
		<div id="layoutSidenav_content">
			<main>
				@* Mensaje de error *@
				@if (TempData["Mensaje"] != null)
				{
					<div class="alert alert-warning alert-dismissible fade show" role="alert">
						<strong>Email!</strong> @TempData["Mensaje"]
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				}
				<div class="container-fluid px-4">
					@RenderBody()
				</div>
			</main>
			<footer class="py-4 bg-light mt-auto">
				<div class="container-fluid px-4">
					<div class="d-flex align-items-center justify-content-between small">
						<div class="text-muted">Copyright &copy; Your Website 2023</div>
						<div>
							<a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
							&middot;
							<a href="#">Terms &amp; Conditions</a>
						</div>
					</div>
				</div>
			</footer>
		</div>
	</div>

	<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
	<script src="https://cdn.datatables.net/2.2.1/js/dataTables.js"></script>
	<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.6/js/dataTables.responsive.min.js"></script>

	<script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap-sweetalert/dist/sweetalert.min.js"></script>

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/scripts.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			document.querySelectorAll(".toggle-submenu").forEach(item => {
				item.addEventListener("click", function (event) {
					event.preventDefault(); // Evita que el enlace recargue la página

					const submenu = this.nextElementSibling; // Encuentra el UL correspondiente
					submenu.classList.toggle("show"); // Alterna la visibilidad del submenú

					this.classList.toggle("active"); // Alterna la flecha de rotación en el botón
				});
			});
		});


		document.addEventListener("DOMContentLoaded", function () {
			fetchSecciones();
		});

		function fetchSecciones() {
			fetch('/Secciones/CargarSecciones') // Llamada a la API para obtener la Vista Parcial
				.then(response => response.text())
				.then(html => {
					document.getElementById('secciones-container').innerHTML = html;
				})
				.catch(error => {
					console.error('Error cargando secciones:', error);
					document.getElementById('secciones-container').innerHTML =
						'<p class="text-muted px-3">Error al cargar secciones</p>';
				});
		}
	</script>

</body>
</html>
