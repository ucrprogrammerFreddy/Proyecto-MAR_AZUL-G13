@model AppUsuarios.Models.Secciones

@{
    ViewData["Title"] = "Editar Sección";
}

<h1>Editar Sección</h1>

<h4>Detalles de la Sección</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="IdSeccion" />

            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImagenFile" class="control-label">Imagen de la Sección</label>
                <input asp-for="ImagenFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="ImagenFile" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImagenURL))
            {
                <div class="form-group">
                    <label>Imagen actual:</label>
                    <br />
                    <img src="~/uploads/@Model.ImagenURL" class="img-thumbnail" style="max-width: 200px;" />
                </div>
            }

            <div class="form-group">
                <label asp-for="Estado" class="control-label"></label>
                <select asp-for="Estado" class="form-control">
                    <option selected="selected" value="A">Activo</option>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <option value="I">Inactivo</option>
                    }
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
