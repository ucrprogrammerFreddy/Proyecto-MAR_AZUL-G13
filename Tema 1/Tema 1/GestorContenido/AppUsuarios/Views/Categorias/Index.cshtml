@model IEnumerable<AppUsuarios.Models.Categorias>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="container mt-4">
    <h2 class="text-center text-primary">Gestión de Categorías</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Agregar Nueva Categoría
        </a>
        <input type="text" class="form-control w-25" placeholder="Buscar categoría..." id="searchInput" />
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Mensaje:</strong> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table id="tablaCategorias" class="table table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Sección</th>
                    <th>Descripción</th>
                    <th>Imagen</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var categoria in Model)
                    {
                        <tr id="row-@categoria.IdCategoria">
                            <td>@categoria.IdCategoria</td>
                            <td>@categoria.Nombre</td>
                            <td>@categoria.Seccion</td>
                            <td>@categoria.Descripcion</td>
                            <td>
                                @if (!string.IsNullOrEmpty(categoria.UrlImagen))
                                {
                                    <img src="@categoria.UrlImagen" alt="@categoria.Nombre" class="categoria-imagen" />
                                }
                                else
                                {
                                    <span>Sin imagen</span>
                                }
                            </td>
                            <td>
                                @(categoria.Estado == 'A' ? "Activo" : "Inactivo")
                            </td>
                            <td>
                                <!-- Botón para editar -->
                                <a asp-action="Edit" asp-route-id="@categoria.IdCategoria" class="btn btn-primary" title="Editar">
                                    <i class="fas fa-edit"></i> Editar
                                </a>


                                <!-- Botón para eliminar -->
                                <a asp-action="Delete" asp-route-id="@categoria.IdCategoria" class="btn btn-danger" title="Eliminar">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No se encontraron categorías.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="loadingIndicator" class="text-center d-none">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>

    <div id="errorMessage" class="alert alert-danger d-none" role="alert">
        Error al cargar las categorías. Por favor, intente nuevamente.
    </div>
</div>

<!-- Se agrega un formulario oculto para incluir el AntiForgeryToken -->
<form id="deleteForm">
    @Html.AntiForgeryToken()
</form>

<style>
    .table th {
        background-color: #f8f9fa;
        vertical-align: middle;
    }

    .table td {
        vertical-align: middle;
    }

    .btn {
        margin: 0 2px;
        padding: 0.5rem 0.75rem;
        font-size: 1rem;
    }

    #searchInput {
        min-width: 200px;
    }

    .categoria-imagen {
        max-width: 50px;
        max-height: 50px;
        object-fit: cover;
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById("searchInput").addEventListener("keyup", function () {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll("#tablaCategorias tbody tr");

                rows.forEach(row => {
                    let nombre = row.querySelector("td:nth-child(2)").textContent.toLowerCase();
                    row.style.display = nombre.includes(filter) ? "" : "none";
                });
            });
        });
    </script>
}