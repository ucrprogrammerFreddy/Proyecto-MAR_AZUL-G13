@model AppUsuarios.Models.Categorias

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Categoría</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="IdCategoria" />

            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="IdSeccion">Sección</label>
                @Html.DropDownListFor(model => model.IdSeccion, ViewData["IdSeccion"] as List<SelectListItem>, "Seleccione una Sección", new { @class = "form-control" })
                <span asp-validation-for="IdSeccion" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImagenFile" class="control-label">Imagen de la Categoría</label>
                <input asp-for="ImagenFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="ImagenFile" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Estado" class="control-label"></label>
                <select asp-for="Estado" class="form-control">
                    <option value="A">Activo</option>
                    <option value="I">Inactivo</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}